  \node[stat=slate, right=of b] (c) {\textcolor{slate}{\textbf{\large $\sim$10\%}}\\[1pt]both causes in\\the top two};
  \node[stat=brand, right=of c] (d) {\textcolor{brand}{\textbf{\large 91\%}}\\[1pt]single-fault cases\\kept whole};
